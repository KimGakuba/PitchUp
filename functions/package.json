{
  "name": "pitchup-functions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --project demo-pitchup --config ../firebase/firebase.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run test/booking-overlap.test.ts test/cost-split.test.ts",
    "test:rules": "vitest run test/rules.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "firebase": "^12.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
